{
  "name": "startcloud-ui",
  "version": "0.52.0",
  "private": true,
  "description": "One React/Vite web UI for the STARTcloud estate — a single build that serves whichever backend hosts it: BoxVault, the Provisioner Catalog, the VDI Health Monitor and the identity provider, with further apps to follow.",
  "type": "module",
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@cubone/react-file-manager": "^1.35.0",
    "@devolutions/iron-remote-desktop": "file:vendor/iron-remote-desktop",
    "@devolutions/iron-remote-desktop-rdp": "file:vendor/iron-remote-desktop-rdp",
    "@intl-tel-input/react": "^29.2.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "echarts": "^6.0.0",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "intl-tel-input": "^29.2.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "loglevel": "^1.9.2",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-vnc": "^3.2.0",
    "register-service-worker": "^1.7.2",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "dev": "vite",
    "themes": "node scripts/themes.js",
    "mock": "node scripts/mock-hyperweaver.js",
    "prebuild": "npm run themes",
    "build": "vite build",
    "preview": "vite preview",
    "client": "vite dev --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn",
    "quality": "npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format:fix",
    "test": "npm run test:unit && npm run test:features",
    "test:unit": "vitest run --coverage",
    "test:features": "bddgen && playwright test",
    "test:features:ui": "bddgen && playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-bdd": "9.2.1",
    "prettier": "^3.9.8",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.0.0",
    "vitest": "^5.0.2"
  }
}
