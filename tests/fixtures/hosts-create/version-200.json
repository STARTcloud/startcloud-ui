{
  "name": "startcloud",
  "version": "0.1.27",
  "dir": "startcloud/0.1.27",
  "metadata": {
    "name": "startcloud",
    "version": "0.1.27",
    "description": "The STARTcloud provisioner, generic edition",
    "id_files": {
      "safe_id_dir": "user-safe-ids",
      "keep_original_name": false
    },
    "metadata": {
      "label": "STARTcloud",
      "description": "The STARTcloud provisioner, generic edition",
      "roles": [
        {
          "name": "networking",
          "label": "Networking",
          "description": "Network post boot configurations",
          "collection": "startcloud.startcloud_roles",
          "tags": "always",
          "default_enabled": true,
          "required": true
        },
        {
          "name": "docker",
          "label": "Docker",
          "description": "Installs the Docker engine",
          "collection": "startcloud.startcloud_roles",
          "default_enabled": false
        },
        {
          "name": "domino_install",
          "label": "Domino Server",
          "description": "Installs the HCL Domino server from the configured installer archive",
          "collection": "startcloud.hcl_roles",
          "default_enabled": true,
          "installer_dir": "domino",
          "files": {
            "installer": {
              "answers": {
                "name": "DOMINO_INSTALLER",
                "hash": "DOMINO_HASH",
                "major": "DOMINO_INSTALLER_MAJOR_VERSION",
                "minor": "DOMINO_INSTALLER_MINOR_VERSION",
                "patch": "DOMINO_INSTALLER_PATCH_VERSION"
              }
            },
            "fixpack": {
              "answers": {
                "name": "DOMINO_INSTALLER_FIXPACK",
                "hash": "DOMINO_FP_HASH",
                "version": "DOMINO_INSTALLER_FIXPACK_VERSION",
                "install": "DOMINO_INSTALLER_FIXPACK_INSTALL"
              }
            },
            "hotfix": {
              "answers": {
                "name": "DOMINO_INSTALLER_HOTFIX",
                "hash": "DOMINO_HF_HASH",
                "version": "DOMINO_INSTALLER_HOTFIX_VERSION",
                "install": "DOMINO_INSTALLER_HOTFIX_INSTALL"
              }
            }
          }
        },
        {
          "name": "domino_leap",
          "label": "HCL Leap",
          "description": "Installs HCL Leap from the configured archive",
          "collection": "startcloud.hcl_roles",
          "default_enabled": false,
          "depends_on": ["domino_install"],
          "installer_dir": "leap",
          "files": {
            "installer": {
              "answers": {
                "name": "LEAP_INSTALLER",
                "hash": "LEAP_HASH",
                "version": "LEAP_INSTALLER_VERSION"
              }
            },
            "hotfix": {
              "answers": {
                "name": "LEAP_HOTFIX",
                "hash": "LEAP_HF_HASH",
                "version": "LEAP_HOTFIX_VERSION",
                "install": "LEAP_HOTFIX_INSTALL"
              }
            }
          }
        }
      ],
      "configuration": {
        "groups": [
          {
            "name": "guest",
            "label": "Guest",
            "advanced": false
          },
          {
            "name": "installers",
            "label": "Installer Archives",
            "advanced": true
          },
          {
            "name": "proxy",
            "label": "Download Proxy",
            "advanced": true
          }
        ],
        "fields": [
          {
            "name": "guest_user",
            "label": "Guest user",
            "type": "text",
            "group": "guest",
            "required": true,
            "default": "startcloud"
          },
          {
            "name": "guest_password",
            "label": "Guest password",
            "type": "password",
            "group": "guest",
            "required": false,
            "generate": {
              "length": 16
            }
          },
          {
            "name": "DOMINO_INSTALLER",
            "label": "Domino Server Installer Archive",
            "type": "text",
            "group": "installers",
            "default": "Domino_14.0_Linux_English.tar"
          },
          {
            "name": "DOMINO_HASH",
            "label": "Domino Installer SHA256 Hash",
            "type": "text",
            "group": "installers"
          },
          {
            "name": "DOMINO_INSTALLER_MAJOR_VERSION",
            "label": "Domino Major Version",
            "type": "number",
            "group": "installers",
            "default": 14
          },
          {
            "name": "DOMINO_INSTALLER_MINOR_VERSION",
            "label": "Domino Minor Version",
            "type": "number",
            "group": "installers",
            "default": 0
          },
          {
            "name": "DOMINO_INSTALLER_PATCH_VERSION",
            "label": "Domino Patch Version",
            "type": "number",
            "group": "installers",
            "default": 0
          },
          {
            "name": "DOMINO_INSTALLER_FIXPACK_INSTALL",
            "label": "Install a Domino Fixpack",
            "type": "checkbox",
            "group": "installers",
            "default": false
          },
          {
            "name": "DOMINO_INSTALLER_FIXPACK",
            "label": "Domino Fixpack Archive",
            "type": "text",
            "group": "installers",
            "show_if": { "DOMINO_INSTALLER_FIXPACK_INSTALL": true }
          },
          {
            "name": "DOMINO_INSTALLER_FIXPACK_VERSION",
            "label": "Domino Fixpack Version",
            "type": "text",
            "group": "installers",
            "show_if": { "DOMINO_INSTALLER_FIXPACK_INSTALL": true }
          },
          {
            "name": "DOMINO_FP_HASH",
            "label": "Domino Fixpack SHA256 Hash",
            "type": "text",
            "group": "installers",
            "show_if": { "DOMINO_INSTALLER_FIXPACK_INSTALL": true }
          },
          {
            "name": "DOMINO_INSTALLER_HOTFIX_INSTALL",
            "label": "Install a Domino Hotfix",
            "type": "checkbox",
            "group": "installers",
            "default": false
          },
          {
            "name": "DOMINO_INSTALLER_HOTFIX",
            "label": "Domino Hotfix Archive",
            "type": "text",
            "group": "installers",
            "show_if": { "DOMINO_INSTALLER_HOTFIX_INSTALL": true }
          },
          {
            "name": "DOMINO_INSTALLER_HOTFIX_VERSION",
            "label": "Domino Hotfix Version",
            "type": "text",
            "group": "installers",
            "show_if": { "DOMINO_INSTALLER_HOTFIX_INSTALL": true }
          },
          {
            "name": "DOMINO_HF_HASH",
            "label": "Domino Hotfix SHA256 Hash",
            "type": "text",
            "group": "installers",
            "show_if": { "DOMINO_INSTALLER_HOTFIX_INSTALL": true }
          },
          {
            "name": "LEAP_INSTALLER",
            "label": "Leap Installer Archive",
            "type": "text",
            "group": "installers",
            "default": "hcl.dleap-1.1.9.36.zip"
          },
          {
            "name": "LEAP_INSTALLER_VERSION",
            "label": "Leap Version",
            "type": "text",
            "group": "installers",
            "default": "1.1.9"
          },
          {
            "name": "LEAP_HASH",
            "label": "Leap Installer SHA256 Hash",
            "type": "text",
            "group": "installers"
          },
          {
            "name": "LEAP_HOTFIX_INSTALL",
            "label": "Install a Leap Hotfix",
            "type": "checkbox",
            "group": "installers",
            "default": false
          },
          {
            "name": "LEAP_HOTFIX",
            "label": "Leap Hotfix Archive",
            "type": "text",
            "group": "installers",
            "show_if": { "LEAP_HOTFIX_INSTALL": true }
          },
          {
            "name": "LEAP_HOTFIX_VERSION",
            "label": "Leap Hotfix Version",
            "type": "text",
            "group": "installers",
            "show_if": { "LEAP_HOTFIX_INSTALL": true }
          },
          {
            "name": "LEAP_HF_HASH",
            "label": "Leap Hotfix SHA256 Hash",
            "type": "text",
            "group": "installers",
            "show_if": { "LEAP_HOTFIX_INSTALL": true }
          },
          {
            "name": "USE_PROXY",
            "label": "Use HTTP Proxy for Downloads",
            "type": "checkbox",
            "group": "proxy",
            "default": false
          },
          {
            "name": "PROXY_SERVER",
            "label": "Proxy Server",
            "type": "text",
            "group": "proxy",
            "required": true,
            "show_if": { "USE_PROXY": true }
          },
          {
            "name": "PROXY_PORT",
            "label": "Proxy Port",
            "type": "number",
            "group": "proxy",
            "default": 3128,
            "show_if": { "USE_PROXY": true },
            "validate": { "min": 1, "max": 65535 }
          }
        ]
      }
    }
  },
  "role_specs": {
    "roles": {
      "networking": {
        "collection": "startcloud.startcloud_roles",
        "short_description": "Network post boot configurations",
        "options": {}
      },
      "docker": {
        "collection": "startcloud.startcloud_roles",
        "short_description": "Installs the Docker engine",
        "options": {}
      },
      "domino_install": {
        "collection": "startcloud.hcl_roles",
        "short_description": "Installs the HCL Domino server",
        "options": {
          "domino_user": {
            "type": "str",
            "default": "domino",
            "description": "The system user Domino runs as."
          },
          "domino_home_dir": {
            "type": "str",
            "default": "/local/notesdata",
            "description": "The Domino data directory."
          },
          "domino_https_enabled": {
            "type": "bool",
            "default": true,
            "description": "Whether the HTTP task listens with TLS."
          },
          "domino_install_mode": {
            "type": "str",
            "choices": ["full", "minimal"],
            "default": "full",
            "description": "The feature set the installer lays down."
          },
          "domino_organization": {
            "type": "str",
            "required": true,
            "default": "STARTcloud",
            "description": "The Domino organization the server certifies under."
          }
        }
      },
      "domino_leap": {
        "collection": "startcloud.hcl_roles",
        "short_description": "Installs HCL Leap",
        "options": {}
      }
    }
  },
  "playbook_candidates": []
}
