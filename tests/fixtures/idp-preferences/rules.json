{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "maxLength": 10
    },
    "timezone": { "type": "string", "pattern": "^(?:UTC|[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)+)$" },
    "region": { "type": "string", "pattern": "^[A-Z]{2}$|^(EU|EEA|UK)$" }
  },
  "forms": {
    "preferences": {
      "type": "object",
      "properties": {
        "language": { "$ref": "#/$defs/languageTag" },
        "timezone": { "$ref": "#/$defs/timezone" },
        "locale": { "$ref": "#/$defs/languageTag" },
        "hour_cycle": { "type": "string", "enum": ["h12", "h23"] },
        "region": { "$ref": "#/$defs/region" },
        "ciba_channel": { "type": "string", "enum": ["PUSH", "EMAIL", "SMS"] },
        "ciba_user_code": { "type": "string", "minLength": 4, "maxLength": 64 }
      }
    }
  }
}
